# Copy this file to .env and adjust local values. Never commit .env.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Moscow
DJANGO_LANGUAGE_CODE=ru-ru

# Database: sqlite (default, local) or postgresql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# PostgreSQL example (set DB_ENGINE=postgresql):
# DB_ENGINE=postgresql
# DB_NAME=investing
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Market data: demo (synthetic, reproducible) or tinkoff (real API)
MARKET_DATA_PROVIDER=demo
TINKOFF_TOKEN=

# Background price updates: default 5 minutes
PRICE_UPDATE_INTERVAL_SECONDS=300
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false
